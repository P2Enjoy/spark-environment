# Environnement du RUNTIME `sparkd`, sur la Forge.
#
# @spec docs/BACKLOG.md#SPK-100 · docs/DAT.md §53 (aucune option cachée), §50
#       (l'écran d'installation écrit ce fichier) · CLAUDE.md §3 ·
#       README.md « Variables d'environnement → services/sparkd »
#
# Le fichier réel est `/etc/sparkd/sparkd.env`, lu par l'unité systemd
# (`EnvironmentFile=-`). Celui-ci en est le modèle versionné : il porte les noms
# et les commentaires, jamais une valeur réelle.
#
# LA PLUPART DE CES VARIABLES SONT ÉCRITES PAR LE PRODUIT. L'écran
# « Forge → Installer » pose le pool, le pont, les réserves et les ports
# réservés à partir de son formulaire : les modifier à la main sera défait à la
# prochaine installation. Ce fichier sert à LIRE ce que la Forge attend, et à
# poser les quelques réglages qu'aucun écran ne couvre.
#
# Toutes sont facultatives : `sparkd` démarre sans aucune d'elles, sur ses
# valeurs par défaut.

# --- Écoute et registre -------------------------------------------------------

# Adresse d'écoute. `sparkd` REFUSE de démarrer sur une adresse routable et sort
# en code 2 : l'absence d'API d'administration exposée au réseau est une
# propriété de sécurité du produit, pas un réglage laissé à la vigilance.
# Défaut : 127.0.0.1:9876.
SPARKD_BIND=127.0.0.1:9876

# Fichier du registre. Défaut : /var/lib/sparkd/spark.db.
SPARKD_DB=/var/lib/sparkd/spark.db

# Clé de chiffrement des SECRETS d'environnement — 32 octets, `0600`, créée si
# absente et JAMAIS remplacée. Défaut : `secret.key` à côté du registre.
# La clé elle-même ne figure ni ici ni dans aucun document.
SPARKD_SECRET_KEY_FILE=/var/lib/sparkd/secret.key

# --- Ce que l'écran d'installation écrit --------------------------------------

# Pilote d'exécution : `incus` en exploitation, `fake` pour la pile de
# développement. Défaut : incus.
SPARKD_DRIVER=incus

# Socket du gestionnaire de conteneurs. Défaut : /var/lib/incus/unix.socket.
SPARKD_INCUS_SOCKET=/var/lib/incus/unix.socket

# API d'administration du proxy. Défaut : http://127.0.0.1:2019.
SPARKD_CADDY_ADMIN=http://127.0.0.1:2019

# Pool Incus dont la capacité fait foi. Champ « Pool » de l'écran
# d'installation. Défaut : spark.
SPARKD_STORAGE_POOL=spark

# Jeu de données ZFS dont la compression est vérifiée. Défaut : la valeur de
# SPARKD_STORAGE_POOL.
SPARKD_STORAGE_DATASET=spark

# Pont réseau auquel les cellules sont rattachées. Champ « Bridge » de l'écran
# d'installation. Défaut : sparkbr0.
SPARKD_NETWORK_BRIDGE=sparkbr0

# Mémoire soustraite du pool pour la Forge elle-même, hors ARC. Octets ou
# suffixe. Champ de l'écran d'installation.
SPARKD_MEMORY_RESERVE=2GiB

# Part de processeur que la Forge garde pour elle, en cœurs. Décimal >= 0.
SPARKD_CPU_RESERVE=0.5

# Ports que la Forge occupe déjà, jamais attribuables à un Spark — EN PLUS de
# 22, 80 et 443, que le produit réserve toujours. Entiers séparés par des
# virgules.
SPARKD_RESERVED_PORTS=9100,9090

# --- Réglages qu'aucun écran ne couvre ----------------------------------------

# Marge posée au-dessus de la taille vendue de chaque Spark, pour qu'un disque
# plein n'empêche plus sa reconfiguration. Octets ou suffixe. Défaut : 64MiB.
SPARKD_STORAGE_METADATA_MARGIN=64MiB

# Fichier `allowed_signers` d'OpenSSH — clés PUBLIQUES autorisées à signer un
# geste. Vide : la vérification de signature est désactivée.
SPARKD_ALLOWED_SIGNERS=/etc/sparkd/allowed_signers

# Adresse ou nom PUBLIC de la Forge, rendu dans le briefing d'un Spark. IPv4,
# IPv6 ou nom, sans schéma. Vide : le briefing dit que l'adresse est inconnue du
# plan de contrôle — elle n'est JAMAIS déduite de l'IP privée ni d'un appel
# sortant, ce serait inventer un fait réseau.
SPARKD_FORGE_PUBLIC_ADDRESS=

# Canal d'ALERTE hors bande : un POST de JSON y part à chaque geste sensible.
# Vide : la fonction est désactivée. L'URL peut porter un secret — ne la
# committez jamais.
SPARKD_NOTIFY_URL=

# Gabarit du corps envoyé sur ce canal, pour le mettre à la forme qu'exige le
# service visé. JSON portant des `{champ}` ; il ne peut nommer que les champs de
# l'alerte, et un nom inconnu N'ARME PAS le canal. Vide : le corps par défaut
# part tel quel. Exemple pour un service qui attend `content` :
# SPARKD_NOTIFY_TEMPLATE={"content":"**{forge}** — {action} sur {target_id} par {actor}"}
SPARKD_NOTIFY_TEMPLATE=

# Cadence de l'historien d'usage. Durée (`15s`, `1m`). `0` désactive l'historien.
SPARKD_METRICS_INTERVAL=15s

# Durée conservée par l'historien ; ce qui dépasse est purgé à chaque tic.
# `0` désactive la purge, et le registre croît sans limite.
SPARKD_METRICS_RETENTION=7d

# Niveau de journalisation : debug, info, warning, error. Défaut : info.
SPARKD_LOG_LEVEL=info
