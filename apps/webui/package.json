{
  "name": "@spark/webui",
  "private": true,
  "version": "0.0.0",
  "description": "Console d'administration locale : hôte Node porteur des tunnels SSH, et SPA React",
  "type": "module",
  "scripts": {
    "dev": "node host/main.js",
    "build": "echo 'console servie telle quelle par l hote, rien a compiler' && exit 0",
    "test": "node --test modules.test.js host/*.test.js src/components/*.test.js src/styles/*.test.js",
    "typecheck": "tsc --noEmit --allowJs --checkJs false host/*.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  }
}
