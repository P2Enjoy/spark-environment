# Environnement de la CONSOLE, sur le poste de l'exploitant.
#
# @spec docs/BACKLOG.md#SPK-100 · docs/DAT.md §53 (aucune option cachée), §53.1
#       (les quatre cases d'un réglage) · CLAUDE.md §3 · README.md « Variables
#       d'environnement → apps/webui »
#
# Copier en `.env` à la racine du dépôt, puis renseigner ce qui sert. Le `.env`
# n'est JAMAIS versionné ; ce fichier-ci l'est, et ne porte donc aucune valeur
# réelle — ni jeton, ni clé, ni adresse interne.
#
# Tout est FACULTATIF : sans `.env`, la console démarre et fonctionne, le
# pilotage DNS en moins. Une variable exportée dans le shell l'emporte sur ce
# fichier ; une variable exportée VIDE ne l'écrase pas — elle sert à neutraliser
# un héritage.
#
# La règle : aucune variable lue par le code ne vit hors de ce fichier et de la
# documentation. Si vous en ajoutez une, elle vient ici, avec son commentaire,
# dans le même changement que le code qui la lit.

# --- La console elle-même -----------------------------------------------------

# Port local d'écoute de la console. Elle n'écoute jamais sur une adresse
# routable. Défaut : 5173 (`make runDev` ; `make runProd` emploie 5175).
SPARK_CONSOLE_PORT=5173

# Inventaire des serveurs déclarés — le fichier que l'écran « Serveurs » écrit.
# Défaut : ~/.config/spark/servers.json. Le journal et les verrous
# d'installation de Forge, ainsi que les ancres, vivent À CÔTÉ de ce fichier :
# ils suivent ce chemin et n'ont pas de réglage propre.
SPARK_CONSOLE_STATE=~/.config/spark/servers.json

# Emplacement de CE fichier une fois renseigné, si vous le rangez ailleurs.
# Défaut : `.env` à la racine du dépôt.
SPARK_ENV_FILE=./.env

# --- Le pilotage DNS ----------------------------------------------------------
# Sans jeton, la console dit « aucun fournisseur configuré » et tout le reste
# fonctionne : c'est un état normal, pas une panne.

# Jeton du fournisseur DNS. SECRET : ne le committez jamais, ici ou ailleurs.
SCW_SECRET_KEY=

# Organisation dont les zones sont listées. Format : UUID.
SCW_DEFAULT_ORGANIZATION_ID=

# Expression régulière bornant les domaines que CE poste peut écrire. Vide, la
# borne n'est pas appliquée côté poste. Exemple d'un poste de test :
SPARK_DNS_ALLOW_PATTERN=^test\.[a-z0-9-]+\.exemple\.tech$

# Racine de l'API DNS. À ne changer que pour viser un doublon local ; vide, le
# vrai fournisseur est employé — donc des zones en exploitation.
SPARK_DNS_BASE_URL=

# --- La pile d'épreuve --------------------------------------------------------
# docs/DAT.md §53.3. N'y touchez pas pour exploiter : ces quatre commandes
# doublées servent à éprouver la console sans machine distante.
#
# SANS `SPARK_EPREUVE=1`, les quatre variables ci-dessous sont IGNORÉES, et le
# refus est écrit sur la sortie d'erreur au démarrage. AVEC, la console affiche
# un avertissement permanent dans sa barre latérale, qui nomme les commandes
# remplacées — sur tous les écrans, tant que l'interrupteur est actif.
#
# Seule la valeur « 1 » arme l'interrupteur. Le harnais E2E la pose lui-même :
# vous n'avez rien à faire ici.
# SPARK_EPREUVE=1

# Remplace la commande du terminal — `ssh` vers un Spark (§37.4.2 bis).
# Commande shell, ou table JSON par Spark.
# SPARK_TERMINAL_COMMAND=

# Remplace la commande `docker` interrogée dans un Spark (§37.6 ter).
# Table JSON, un script par geste : ps, stats, inspect, logs.
# SPARK_DOCKER_COMMAND=

# Remplace la commande de redémarrage de la Forge (§51.1). Commande shell.
# SPARK_REBOOT_COMMAND=

# Remplace la commande de signature d'un geste (§36.10.9). Commande shell.
# SPARK_SIGN_COMMAND=

# --- Le harnais de preuves ----------------------------------------------------
# Employées par les scripts de `e2e/`, jamais par la console en exploitation.

# Console à viser pour les scripts qui n'en montent pas — `e2e/reel.mjs`,
# `e2e/forge-conformite.mjs`. Défaut : http://127.0.0.1:5173.
# SPARK_CONSOLE_URL=http://127.0.0.1:5173

# Répertoire où ces scripts déposent leurs captures.
# SPARK_SORTIE=e2e/captures

# --- Le pool de stockage ------------------------------------------------------
# Lues par `scripts/creer-pool.sh`, sur la FORGE et non sur le poste. Elles se
# posent à la ligne de commande, devant le script :
#
#   sudo SPARK_POOL_SOURCE=/dev/sda5,/dev/sdb5 scripts/creer-pool.sh
#
# Elles figurent ici pour que ce fichier reste l'inventaire COMPLET des
# variables du produit, sans exception.

# Les DEUX supports du miroir, séparés par une virgule. OBLIGATOIRE : sans elle,
# le script refuse plutôt que de créer un pool sur un fichier.
# SPARK_POOL_SOURCE=/dev/sda5,/dev/sdb5

# Nom du pool créé. Défaut : spark.
# SPARK_POOL_NAME=spark

# Pilote de stockage. Défaut : zfs.
# SPARK_POOL_DRIVER=zfs
