# Tranche cgroup parente des Sparks.
#
# @spec docs/BACKLOG.md#SPK-29 · docs/DAT.md §32.1 (le mecanisme), §32.4 (la
#       tranche survit a un redemarrage) · docs/PROD_MIGRATIONS.md OP-05
#
# Sans elle, Incus place chaque Spark a la RACINE de cgroup v2, frere de
# system.slice : le poids d'un Spark y est arbitre contre l'hote autant que
# contre les autres Sparks, et sa reservation n'est proportionnelle qu'entre
# Sparks.
#
# Mesure le 2026-08-19 : une tranche creee a la main dans /sys/fs/cgroup
# DISPARAIT au redemarrage. Les Sparks retomberaient alors a la racine et la
# reservation redeviendrait proportionnelle SANS QUE RIEN NE LE SIGNALE. D'ou
# cette unite, activee au demarrage.

[Unit]
Description=Tranche des cellules Spark
Documentation=https://github.com/P2Enjoy/spark-environment
Before=incus.service

[Slice]
# `sparkd` recalcule ce poids a chaque changement d'allocation : il doit valoir
# ce que les Sparks ont achete (docs/DAT.md §32.2). La valeur posee ici n'est
# qu'un point de depart pour un hote sans aucun Spark.
CPUWeight=1

# Les controleurs doivent etre delegues, sans quoi les limites d'Incus ne
# s'appliqueraient pas a l'interieur de la tranche.
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
